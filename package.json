{
  "name": "profile-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "biome check .",
    "lint:fix": "biome check . --fix",
    "typecheck": "next typegen && tsc -p tsconfig.json --noEmit",
    "content:check": "tsx scripts/content-check.ts",
    "format": "biome format --write .",
    "format:check": "biome check .",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@next/third-parties": "^16.1.6",
    "clsx": "^2.1.1",
    "next": "16.1.6",
    "next-mdx-remote-client": "^2.1.7",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@chromatic-com/storybook": "^5.0.1",
    "@playwright/test": "^1.58.2",
    "@storybook/addon-a11y": "^10.2.17",
    "@storybook/addon-docs": "^10.2.17",
    "@storybook/addon-onboarding": "^10.2.17",
    "@storybook/addon-vitest": "^10.2.17",
    "@storybook/nextjs-vite": "^10.2.17",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.2.7",
    "playwright": "^1.58.2",
    "storybook": "^10.2.17",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18",
    "zod": "^4.3.6"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,mdx,json}": [
      "biome check ."
    ]
  }
}
